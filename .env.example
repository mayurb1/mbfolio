# Environment variables for the Next.js app.
# Copy to `.env.local` (gitignored) for local dev, and set the same keys in the
# Netlify dashboard for deploys. NEXT_PUBLIC_* are exposed to the browser;
# everything else is server-only (Route Handlers / SSR).

# --- Server-only ---
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
FRONTEND_URL=http://localhost:3000

# --- Client (exposed to browser) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Contact form: leave CONTACT_API_URL empty to use Formspree (recommended).
# Do NOT point it at the removed /api/contact function.
NEXT_PUBLIC_CONTACT_API_URL=
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id
